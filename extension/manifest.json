{
  "manifest_version": 3,
  "name": "zap · WhatsApp Web (read only)",
  "version": "0.1.0",
  "description": "Reads only the chats you follow, in your own browser, and keeps the events in chrome.storage.local. Nothing leaves the browser.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "zap", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["config.js", "vendor/wppconnect-wa.js", "follow.js", "page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["follow.js", "bridge.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  }
}
